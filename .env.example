# Production. Copy to .env.production.local and fill from
# Supabase dashboard -> Project Settings -> API Keys. Never commit the filled file.
#
# Only the publishable key (sb_publishable_…) belongs here. These names match
# what Vercel's Supabase integration injects, and vite.config.ts exposes exactly
# them to the browser bundle. The secret key (sb_secret_…) must never be used in
# this app, nor given a name that envPrefix lets through.
#
# Local development needs nothing here: .env.development is committed and
# points at the stack started by `npx supabase start`.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
