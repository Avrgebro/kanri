# Production. Copy to .env.production.local and fill from
# Supabase dashboard -> Project Settings -> API Keys. Never commit the filled file.
#
# Only the publishable key (sb_publishable_…) belongs here. Every VITE_ variable
# is compiled into the browser bundle, so the secret key (sb_secret_…) must
# never be given a VITE_ name or used in this app.
#
# Local development needs nothing here: .env.development is committed and
# points at the stack started by `npx supabase start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
